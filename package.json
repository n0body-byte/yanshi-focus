{
  "name": "yanshi-focus",
  "version": "1.4.0",
  "description": "面向考研备考的番茄钟、专注历史与待办清单",
  "main": "electron-main.cjs",
  "author": "YanShi",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "icon": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icon.ps1",
    "test": "node --test scripts/*.test.cjs",
    "dist": "npm run icon && electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.yanshi.focus",
    "productName": "研时",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "task-helpers.js",
      "insight-helpers.js",
      "timer-helpers.js",
      "export-helpers.js",
      "desktop-timer-helpers.cjs",
      "electron-main.cjs",
      "preload.cjs",
      "storage-manager.cjs",
      "build/icon.ico",
      "assets/**/*",
      "manifest.json",
      "service-worker.js"
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "YanShi-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "YanShi-${version}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "研时",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "YanShi-${version}-Portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
